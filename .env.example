# Copy this file to `.env` and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# Optional: override the model used for extraction.
# PITCH2ONEPAGER_MODEL=claude-sonnet-4-6

# Optional: web service only. When set, the upload form requires this password.
# Leave unset and a deployed instance is open to anyone with the URL.
# APP_PASSWORD=
